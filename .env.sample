# repo-atlas 設定ファイルのサンプル
# install.sh が ~/.config/repo-atlas/.env にコピーします (既存の .env は上書きせず、不足キーのみ追記)。
# 注意: podman の EnvironmentFile として読むため、値をクォートで囲まないこと。行末コメントも書かないこと。

# ===== GitHub =====
GITHUB_OWNER=hamashin
GITHUB_API_URL=https://api.github.com
# Fine-grained PAT (All repositories / Contents:Read, Metadata:Read, Pull requests:Read)
GITHUB_TOKEN=
ATLAS_REPO=hamashin/repo-atlas
ATLAS_SSH_URL=git@github.com:hamashin/repo-atlas.git
ATLAS_BRANCH=main
GIT_AUTHOR_NAME=repo-atlas-bot
GIT_AUTHOR_EMAIL=repo-atlas-bot@users.noreply.github.com

# ===== Ollama =====
OLLAMA_URL=http://ollama.example.lan:11434
OLLAMA_MODEL=qwen3:14b
# 1 回の LLM 呼び出しの上限。実際には実行の残り時間でさらに短く打ち切る
OLLAMA_TIMEOUT_SEC=1000
# Ollama に載っている他用途と揃えると、モデルの再読み込みが起きにくい
OLLAMA_NUM_CTX=24576
OLLAMA_DISABLE_THINK=true

# ===== 通知 =====
SLACK_WEBHOOK_URL=

# ===== 公開制御 =====
# 新規リポジトリの公開レベル (full / summary / hidden)
DEFAULT_LEVEL=summary
# マスク対象の内部ドメイン (カンマ区切り。サブドメインも対象)
INTERNAL_DOMAINS=example.internal
# マスク対象の語 (カンマ区切り。内部ホスト名・ユーザー名など)
DENY_TERMS=
# LLM に渡さない追加の除外パターン (カンマ区切りの glob)
EXTRA_EXCLUDE_GLOBS=
MAX_INPUT_CHARS=16000
MAX_TARBALL_MB=200
# 取得できたリポジトリ数が既知数のこの割合未満なら、削除処理を見送る (API 異常対策)
MIN_LISTING_RATIO=0.5

# ===== 実行 =====
TZ=Asia/Tokyo
# 1 回の実行の持ち時間 (コンテナのタイムアウトより短くする)。
# 超えそうなら新しい解析を始めず、続きの実行に回す (1 回で最低 1 件は解析する)
RUN_DEADLINE_SEC=1080
# 残り時間がこれ未満なら新しい解析を始めない
MIN_LLM_SEC=300
DRY_RUN=false

# ===== コンテナ内パス =====
DATA_DIR=/data
APP_DIR=/app
REPOS_CONFIG_PATH=/config/repos.yaml
DEPLOY_KEY_PATH=/run/secrets/deploy_key
KNOWN_HOSTS_PATH=/run/secrets/known_hosts

# ===== ホスト側 (install.sh が使用) =====
# 空なら ~/.local/share/repo-atlas
HOST_DATA_DIR=
IMAGE_NAME=localhost/repo-atlas:latest
SCHEDULE_ONCALENDAR=*-*-* 08:00:00
# コンテナのタイムアウト (20 分)。超えたら Slack 通知
RUN_TIMEOUT_SEC=1200
# 失敗時に 1 回だけ再実行するまでの待ち時間
RETRY_DELAY_SEC=1800
# 未解析分が残ったとき、続きを実行するまでの待ち時間
CATCHUP_DELAY_SEC=60
GITLEAKS_VERSION=8.30.1
GITLEAKS_SHA256=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb
